# ========== Telegram Bot 配置 ==========
TG_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# 默认目标频道/群组的 chat_id（不带 chat_id 的通知都发这里）
TG_CHAT_ID=123456789

# 频道别名表（可选）：把好记的名字映射到真实 chat_id，
# 之后 /notify 传 chat_id="research" 即可，不用记数字 ID。
# 必须是合法 JSON（一行）。把 bot 拉进新群后在群里发 /id 获取 chat_id。
# TG_CHATS={"research": -1001234567890, "signal": -1009876543210}

# ========== API 认证密钥（自定义） ==========
NOTIFY_API_KEY=your-secret-key-here

# ========== 服务端口 ==========
NOTIFY_PORT=8000

# ========== Twilio 配置（电话告警） ==========
# 在 https://console.twilio.com 获取
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+1234567890
# 你的手机号（接收电话，香港号码格式：+852xxxxxxxx）
PHONE_TO=+852xxxxxxxx

# ========== 告警配置 ==========
# Critical 告警多少秒后未确认打电话（默认 300 秒 = 5 分钟）
CALL_DELAY_SECONDS=300
